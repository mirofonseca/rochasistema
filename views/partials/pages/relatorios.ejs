<div class="page" id="page-relatorios">
  <div class="ph">
    <div class="ph-left">
      <div class="ph-tag">Análises</div>
      <div class="ph-title">Relatórios</div>
      <div class="ph-sub">Desempenho financeiro e operacional</div>
    </div>
  </div>

  <!-- Filtro por período -->
  <div class="card" style="margin-bottom:16px">
    <div class="card-body" style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap">
      <div class="fg">
        <label style="font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:4px">Data Início</label>
        <input class="inp" type="date" id="rel-inicio" style="padding:8px 10px">
      </div>
      <div class="fg">
        <label style="font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:4px">Data Fim</label>
        <input class="inp" type="date" id="rel-fim" style="padding:8px 10px">
      </div>
      <button class="btn btn-primary" onclick="filtrarRelatorio()">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        Filtrar
      </button>
      <button class="btn btn-ghost" onclick="limparFiltroRelatorio()">Últimos 12 meses</button>
    </div>
  </div>

  <!-- Cards de resumo -->
  <div class="stats-grid" id="rel-stats"></div>

  <!-- Gráfico de receita mensal -->
  <div class="card" style="margin-bottom:16px">
    <div class="card-hd">
      <div class="card-title">Receita por Mês</div>
      <div style="font-size:11px;color:var(--muted)" id="rel-chart-subtitle"></div>
    </div>
    <div class="card-body">
      <div class="chart-wrap" id="rel-chart-mensal"></div>
      <div class="rel-legenda">
        <div class="rel-leg-item"><div class="rel-leg-dot" style="background:var(--org)"></div>Receita Base</div>
        <div class="rel-leg-item"><div class="rel-leg-dot" style="background:var(--amb)"></div>Valor Extra</div>
      </div>
    </div>
  </div>

  <!-- Receita por Reboque e Top Clientes -->
  <div class="rel-card-grp">
    <div class="card">
      <div class="card-hd"><div class="card-title">Receita por Reboque</div></div>
      <div class="card-body" id="rel-por-reboque"></div>
    </div>
    <div>
      <div class="card" style="margin-bottom:16px">
        <div class="card-hd"><div class="card-title">Top Clientes</div></div>
        <div class="card-body np" id="rel-top-cli"></div>
      </div>
      <div class="card">
        <div class="card-hd"><div class="card-title">Resumo de Pagamentos</div></div>
        <div class="card-body" id="rel-pagamentos"></div>
      </div>
    </div>
  </div>
</div>
